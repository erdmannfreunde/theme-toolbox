{% extends '@Contao/be_main.html.twig' %}

{% block main %}
    <main id="main" aria-labelledby="main_headline">
        <h1 id="main_headline">{{ headline }}</h1>

        <div class="theme-file-editor content">
            <div id="tl_buttons" class="theme-file-editor-operations operations">
                <nav class="theme-file-editor-tabs">
                    <a href="{{ path('theme_file_editor_index', {theme: selected_theme, tab: 'styles'}) }}" class="theme-file-editor-tabs__tab{{ active_tab == 'styles' ? ' theme-file-editor-tabs__tab--active' : '' }}">Styles</a>
                    <a href="{{ path('theme_file_editor_index', {theme: selected_theme, tab: 'webfonts'}) }}" class="theme-file-editor-tabs__tab{{ active_tab == 'webfonts' ? ' theme-file-editor-tabs__tab--active' : '' }}">Webfonts</a>
                </nav>
                {% if active_tab == 'styles' and selected_file %}
                    <div class="theme-file-editor__actions">
                        <button type="button" class="action" id="saveBtn" onclick="ThemeFileEditor.save()">
                            <img src="/system/themes/flexible/icons/editor.svg" alt="" width="16" height="16">
                            <span>{{ 'save'|trans({}, 'contao_tl_theme_file_editor') }}</span>
                        </button>
                        {% if is_custom and not is_custom_only %}
                            <button type="button" class="action" id="showDiffBtn" onclick="ThemeFileEditor.toggleDiff()">
                                <img src="/system/themes/flexible/icons/diffTemplate.svg" alt="" width="16" height="16">
                                <span>{{ 'showDiff'|trans({}, 'contao_tl_theme_file_editor') }}</span>
                            </button>
                            <button type="button" class="action" id="revertBtn" onclick="ThemeFileEditor.revert()">
                                <img src="/system/themes/flexible/icons/undo.svg" alt="" width="16" height="16">
                                <span>{{ 'revert'|trans({}, 'contao_tl_theme_file_editor') }}</span>
                            </button>
                        {% endif %}
                        {% if is_custom_only %}
                            <button type="button" class="action action--danger" id="deleteBtn" onclick="ThemeFileEditor.deleteFile()">
                                <img src="/system/themes/flexible/icons/delete.svg" alt="" width="16" height="16">
                                <span>{{ 'delete'|trans({}, 'contao_tl_theme_file_editor') }}</span>
                            </button>
                        {% endif %}
                    </div>
                {% elseif active_tab == 'webfonts' %}
                    <div class="theme-file-editor__actions">
                        <button type="button" class="action" onclick="ThemeWebfonts.toggleUploadPanel()">
                            <img src="/system/themes/flexible/icons/theme_import.svg" alt="" width="16" height="16">
                            <span>Schriften manuell hochladen</span>
                        </button>
                        <button type="button" class="action" onclick="ThemeWebfonts.cleanupUnusedFontFaces()">
                            <img src="/system/themes/flexible/icons/wrench.svg" alt="" width="16" height="16">
                            <span>Ungenutzte @font-face bereinigen</span>
                        </button>
                    </div>
                {% endif %}
            </div>

            {% if active_tab == 'webfonts' %}
                {{ include('@ErdmannFreundeThemeToolbox/backend/theme_file_editor/_webfonts.html.twig') }}
            {% else %}
                {{ include('@ErdmannFreundeThemeToolbox/backend/theme_file_editor/_styles.html.twig') }}
            {% endif %}
        </div>
    </main>
{% endblock %}
