{% set editor = editor|default('ThemeFileEditor') %}

{% macro render_tree(tree, selected_file, current_path, editor) %}
    <ul class="theme-file-editor__tree">
        {# First render directories #}
        {% for name, content in tree %}
            {% if name != '_files' %}
                {% set dir_path = current_path ? current_path ~ '/' ~ name : name %}
                <li class="theme-file-editor__tree-folder">
                    <span class="theme-file-editor__tree-folder-name">
                        {{ name }}
                        <button type="button" class="theme-file-editor__tree-folder-add" onclick="{{ editor }}.showCreateInput('{{ dir_path|e('js') }}', this)" title="{{ 'createFile'|trans({}, 'contao_tl_theme_file_editor') }}">
                            <img src="/system/themes/flexible/icons/new.svg" alt="" width="12" height="12">
                        </button>
                    </span>
                    {{ _self.render_tree(content, selected_file, dir_path, editor) }}
                </li>
            {% endif %}
        {% endfor %}

        {# Then render files #}
        {% if tree._files is defined %}
            {% for file in tree._files %}
                {% set classes = 'theme-file-editor__tree-file' %}
                {% if file.path == selected_file %}
                    {% set classes = classes ~ ' theme-file-editor__tree-file--selected' %}
                {% endif %}
                {% if file.hasCustom %}
                    {% set classes = classes ~ ' theme-file-editor__tree-file--custom' %}
                {% endif %}
                {% if file.isCustomOnly is defined and file.isCustomOnly %}
                    {% set classes = classes ~ ' theme-file-editor__tree-file--custom-only' %}
                {% endif %}
                <li class="{{ classes }}">
                    <a href="javascript:void(0)" onclick="{{ editor }}.selectFile('{{ file.path|e('js') }}')">
                        {{ file.name }}
                        {% if file.isCustomOnly is defined and file.isCustomOnly %}
                            <span class="theme-file-editor__custom-only-indicator">+</span>
                        {% elseif file.hasCustom %}
                            <span class="theme-file-editor__custom-indicator">*</span>
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        {% endif %}
    </ul>
{% endmacro %}

{{ _self.render_tree(tree, selected_file, '', editor) }}
