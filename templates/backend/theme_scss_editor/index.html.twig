{% extends '@Contao/be_main.html.twig' %}

{% block main %}
    <main id="main" aria-labelledby="main_headline">
        <h1 id="main_headline">{{ headline }}</h1>

        <div id="tl_buttons">
            <a href="{{ back_url }}" class="header_back" title="{{ 'MSC.backBTTitle'|trans({}, 'contao_default') }}">
                {{ 'MSC.backBT'|trans({}, 'contao_default') }}
            </a>
        </div>

        <div class="theme-scss-editor">
            <div class="theme-scss-editor__toolbar">
                <div class="theme-scss-editor__theme-select">
                    <label for="themeSelect">{{ 'selectTheme'|trans({}, 'contao_tl_theme_scss') }}:</label>
                    <select id="themeSelect" class="tl_select" onchange="ThemeScssEditor.changeTheme(this.value)">
                        {% for name, path in themes %}
                            <option value="{{ name }}"{{ name == selected_theme ? ' selected' : '' }}>{{ name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="theme-scss-editor__container">
                <div class="theme-scss-editor__sidebar">
                    <div class="theme-scss-editor__files">
                        <h3>{{ 'scssFiles'|trans({}, 'contao_tl_theme_scss') }}</h3>
                        <div class="theme-scss-editor__file-tree">
                            {{ include('@ErdmannFreundeThemeToolbox/backend/theme_scss_editor/_file_tree.html.twig', {tree: files, selected_file: selected_file}) }}
                        </div>
                    </div>
                </div>

                <div class="theme-scss-editor__main">
                    {% if selected_file %}
                        <div class="theme-scss-editor__actions">
                            <button type="button" class="tl_submit" id="saveBtn" onclick="ThemeScssEditor.save()">
                                {{ 'save'|trans({}, 'contao_tl_theme_scss') }}
                            </button>
                            {% if is_custom %}
                                <button type="button" class="tl_submit" id="revertBtn" onclick="ThemeScssEditor.revert()">
                                    {{ 'revert'|trans({}, 'contao_tl_theme_scss') }}
                                </button>
                            {% endif %}
                            <button type="button" class="tl_submit" id="showDiffBtn" onclick="ThemeScssEditor.toggleDiff()" style="{{ is_custom ? '' : 'display:none' }}">
                                {{ 'showDiff'|trans({}, 'contao_tl_theme_scss') }}
                            </button>
                        </div>

                        <div id="editorWrapper" class="theme-scss-editor__editors">
                            <div class="theme-scss-editor__editor-panel theme-scss-editor__editor-panel--custom">
                                <div class="theme-scss-editor__panel-header">
                                    <span class="theme-scss-editor__file-name">{{ selected_file }}</span>
                                    {% if is_custom %}
                                        <span class="theme-scss-editor__custom-badge">{{ 'customized'|trans({}, 'contao_tl_theme_scss') }}</span>
                                    {% endif %}
                                </div>
                                <div class="theme-scss-editor__editor-container">
                                    <div id="scssEditor" class="theme-scss-editor__editor">{{ file_content }}</div>
                                </div>
                            </div>

                            <div id="originalPanel" class="theme-scss-editor__editor-panel theme-scss-editor__editor-panel--original" style="display:none">
                                <div class="theme-scss-editor__panel-header theme-scss-editor__panel-header--original">
                                    <span class="theme-scss-editor__file-name">{{ 'originalFile'|trans({}, 'contao_tl_theme_scss') }}</span>
                                </div>
                                <div class="theme-scss-editor__editor-container">
                                    <div id="originalEditor" class="theme-scss-editor__editor theme-scss-editor__editor--readonly">{{ original_content }}</div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="theme-scss-editor__empty">
                            <p>{{ 'selectFile'|trans({}, 'contao_tl_theme_scss') }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <script src="{{ asset('assets/ace/js/ace.js') }}"></script>
        <script>
        var ThemeScssEditor = {
            editor: null,
            originalEditor: null,
            theme: '{{ selected_theme|e('js') }}',
            file: '{{ selected_file|e('js') }}',
            csrfToken: '{{ csrf_token }}',
            isCustom: {{ is_custom ? 'true' : 'false' }},
            showingDiff: false,
            originalContent: {{ original_content|json_encode|raw }},
            diffMarkers: [],

            init: function() {
                var editorEl = document.getElementById('scssEditor');
                if (editorEl) {
                    this.editor = ace.edit('scssEditor');
                    this.editor.setTheme((document.documentElement.dataset.colorScheme === 'dark' ? 'ace/theme/twilight' : 'ace/theme/clouds'));
                    this.editor.session.setMode('ace/mode/scss');
                    this.editor.setOptions({
                        fontSize: '14px',
                        showPrintMargin: false,
                        tabSize: 2,
                        useSoftTabs: true
                    });

                    this.editor.commands.addCommand({
                        name: 'save',
                        bindKey: {win: 'Ctrl-S', mac: 'Cmd-S'},
                        exec: function() { ThemeScssEditor.save(); }
                    });

                    editorEl.classList.add('theme-scss-editor__editor--ready');
                }

                var originalEditorEl = document.getElementById('originalEditor');
                if (originalEditorEl) {
                    this.originalEditor = ace.edit('originalEditor');
                    this.originalEditor.setTheme((document.documentElement.dataset.colorScheme === 'dark' ? 'ace/theme/twilight' : 'ace/theme/clouds'));
                    this.originalEditor.session.setMode('ace/mode/scss');
                    this.originalEditor.setReadOnly(true);
                    this.originalEditor.setOptions({
                        fontSize: '14px',
                        showPrintMargin: false,
                        tabSize: 2
                    });

                    originalEditorEl.classList.add('theme-scss-editor__editor--ready');
                }
            },

            changeTheme: function(theme) {
                window.location.href = '{{ path('theme_scss_editor_index') }}?theme=' + encodeURIComponent(theme);
            },

            selectFile: function(file) {
                window.location.href = '{{ path('theme_scss_editor_index') }}?theme=' + encodeURIComponent(this.theme) + '&file=' + encodeURIComponent(file);
            },

            save: function() {
                var content = this.editor.getValue();
                var btn = document.getElementById('saveBtn');
                btn.disabled = true;
                btn.textContent = '{{ 'saving'|trans({}, 'contao_tl_theme_scss')|e('js') }}';

                fetch('{{ path('theme_scss_editor_save') }}', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                    body: 'theme=' + encodeURIComponent(this.theme) +
                          '&file=' + encodeURIComponent(this.file) +
                          '&content=' + encodeURIComponent(content) +
                          '&REQUEST_TOKEN=' + encodeURIComponent(this.csrfToken)
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    btn.disabled = false;
                    btn.textContent = '{{ 'save'|trans({}, 'contao_tl_theme_scss')|e('js') }}';
                    if (data.success) {
                        ThemeScssEditor.showMessage(data.message, 'success');
                        if (data.isCustom && !ThemeScssEditor.isCustom) {
                            ThemeScssEditor.isCustom = true;
                            ThemeScssEditor.updateUI();
                        }
                        if (ThemeScssEditor.showingDiff) {
                            ThemeScssEditor.highlightDiff();
                        }
                    } else {
                        ThemeScssEditor.showMessage(data.error || data.message, 'error');
                    }
                })
                .catch(function(error) {
                    btn.disabled = false;
                    btn.textContent = '{{ 'save'|trans({}, 'contao_tl_theme_scss')|e('js') }}';
                    ThemeScssEditor.showMessage('Error: ' + error, 'error');
                });
            },

            revert: function() {
                if (!confirm('{{ 'confirmRevert'|trans({}, 'contao_tl_theme_scss')|e('js') }}')) {
                    return;
                }

                fetch('{{ path('theme_scss_editor_revert') }}', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                    body: 'theme=' + encodeURIComponent(this.theme) +
                          '&file=' + encodeURIComponent(this.file) +
                          '&REQUEST_TOKEN=' + encodeURIComponent(this.csrfToken)
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data.success) {
                        ThemeScssEditor.showMessage(data.message, 'success');
                        ThemeScssEditor.editor.setValue(data.content, -1);
                        ThemeScssEditor.isCustom = false;
                        ThemeScssEditor.updateUI();
                        ThemeScssEditor.clearDiffMarkers();
                    } else {
                        ThemeScssEditor.showMessage(data.error || data.message, 'error');
                    }
                })
                .catch(function(error) {
                    ThemeScssEditor.showMessage('Error: ' + error, 'error');
                });
            },

            toggleDiff: function() {
                var wrapper = document.getElementById('editorWrapper');
                var originalPanel = document.getElementById('originalPanel');
                var btn = document.getElementById('showDiffBtn');

                this.showingDiff = !this.showingDiff;

                if (this.showingDiff) {
                    wrapper.classList.add('theme-scss-editor__editors--diff');
                    originalPanel.style.display = 'flex';
                    btn.textContent = '{{ 'hideDiff'|trans({}, 'contao_tl_theme_scss')|e('js') }}';

                    setTimeout(function() {
                        ThemeScssEditor.editor.resize();
                        ThemeScssEditor.originalEditor.resize();
                        ThemeScssEditor.highlightDiff();
                        ThemeScssEditor.syncScroll();
                    }, 50);
                } else {
                    wrapper.classList.remove('theme-scss-editor__editors--diff');
                    originalPanel.style.display = 'none';
                    btn.textContent = '{{ 'showDiff'|trans({}, 'contao_tl_theme_scss')|e('js') }}';
                    this.clearDiffMarkers();

                    setTimeout(function() {
                        ThemeScssEditor.editor.resize();
                    }, 50);
                }
            },

            syncScroll: function() {
                var self = this;
                this.editor.session.on('changeScrollTop', function(scrollTop) {
                    if (self.showingDiff && self.originalEditor) {
                        self.originalEditor.session.setScrollTop(scrollTop);
                    }
                });
                this.originalEditor.session.on('changeScrollTop', function(scrollTop) {
                    if (self.showingDiff && self.editor) {
                        self.editor.session.setScrollTop(scrollTop);
                    }
                });
            },

            // Compute LCS (Longest Common Subsequence) for proper diff
            computeLCS: function(a, b) {
                var m = a.length, n = b.length;
                var dp = [];
                for (var i = 0; i <= m; i++) {
                    dp[i] = [];
                    for (var j = 0; j <= n; j++) {
                        if (i === 0 || j === 0) {
                            dp[i][j] = 0;
                        } else if (a[i - 1] === b[j - 1]) {
                            dp[i][j] = dp[i - 1][j - 1] + 1;
                        } else {
                            dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                        }
                    }
                }
                return dp;
            },

            // Backtrack to find the diff operations
            computeDiff: function(originalLines, customLines) {
                var dp = this.computeLCS(originalLines, customLines);
                var diff = [];
                var i = originalLines.length, j = customLines.length;

                while (i > 0 || j > 0) {
                    if (i > 0 && j > 0 && originalLines[i - 1] === customLines[j - 1]) {
                        diff.unshift({ type: 'equal', origLine: i - 1, customLine: j - 1 });
                        i--; j--;
                    } else if (j > 0 && (i === 0 || dp[i][j - 1] >= dp[i - 1][j])) {
                        diff.unshift({ type: 'added', customLine: j - 1 });
                        j--;
                    } else if (i > 0) {
                        diff.unshift({ type: 'removed', origLine: i - 1 });
                        i--;
                    }
                }
                return diff;
            },

            highlightDiff: function() {
                this.clearDiffMarkers();

                var customLines = this.editor.getValue().split('\n');
                var originalLines = this.originalContent ? this.originalContent.split('\n') : [];
                var Range = ace.require('ace/range').Range;

                var diff = this.computeDiff(originalLines, customLines);

                for (var k = 0; k < diff.length; k++) {
                    var op = diff[k];

                    if (op.type === 'added') {
                        var addedMarker = this.editor.session.addMarker(
                            new Range(op.customLine, 0, op.customLine, 1),
                            'diff-added',
                            'fullLine'
                        );
                        this.diffMarkers.push({editor: this.editor, id: addedMarker});
                    } else if (op.type === 'removed') {
                        var removedMarker = this.originalEditor.session.addMarker(
                            new Range(op.origLine, 0, op.origLine, 1),
                            'diff-removed',
                            'fullLine'
                        );
                        this.diffMarkers.push({editor: this.originalEditor, id: removedMarker});
                    }
                }
            },

            clearDiffMarkers: function() {
                this.diffMarkers.forEach(function(marker) {
                    marker.editor.session.removeMarker(marker.id);
                });
                this.diffMarkers = [];
            },

            updateUI: function() {
                var badge = document.querySelector('.theme-scss-editor__custom-badge');
                var revertBtn = document.getElementById('revertBtn');
                var showDiffBtn = document.getElementById('showDiffBtn');

                if (this.isCustom) {
                    if (!badge) {
                        var header = document.querySelector('.theme-scss-editor__panel-header');
                        if (header) {
                            badge = document.createElement('span');
                            badge.className = 'theme-scss-editor__custom-badge';
                            badge.textContent = '{{ 'customized'|trans({}, 'contao_tl_theme_scss')|e('js') }}';
                            header.appendChild(badge);
                        }
                    }
                    if (!revertBtn) {
                        var actions = document.querySelector('.theme-scss-editor__actions');
                        if (actions) {
                            revertBtn = document.createElement('button');
                            revertBtn.type = 'button';
                            revertBtn.className = 'tl_submit';
                            revertBtn.id = 'revertBtn';
                            revertBtn.textContent = '{{ 'revert'|trans({}, 'contao_tl_theme_scss')|e('js') }}';
                            revertBtn.onclick = function() { ThemeScssEditor.revert(); };
                            actions.insertBefore(revertBtn, showDiffBtn);
                        }
                    }
                    if (showDiffBtn) {
                        showDiffBtn.style.display = '';
                    }
                } else {
                    if (badge) badge.remove();
                    if (revertBtn) revertBtn.remove();
                    if (showDiffBtn) showDiffBtn.style.display = 'none';
                    if (this.showingDiff) {
                        this.toggleDiff();
                    }
                }
            },

            showMessage: function(message, type) {
                var existing = document.querySelector('.theme-scss-editor__message');
                if (existing) existing.remove();

                var msg = document.createElement('div');
                msg.className = 'theme-scss-editor__message theme-scss-editor__message--' + type;
                msg.textContent = message;
                document.querySelector('.theme-scss-editor__main').prepend(msg);

                setTimeout(function() { msg.remove(); }, 5000);
            }
        };

        document.addEventListener('DOMContentLoaded', function() {
            ThemeScssEditor.init();
        });
        </script>
    </main>
{% endblock %}
