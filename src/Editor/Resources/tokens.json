{
  "$version": 1,
  "groups": [
    { "key": "colors", "label": "Farben" },
    { "key": "typography", "label": "Typografie" },
    { "key": "spacing", "label": "Abstände" },
    { "key": "shape", "label": "Form & Rahmen" }
  ],
  "tokens": [
    {
      "property": "--color-brand",
      "group": "colors",
      "label": "Markenfarbe",
      "type": "color",
      "default": "#ff5636",
      "swatch": "primary",
      "core": true
    },
    {
      "property": "--color-text",
      "group": "colors",
      "label": "Textfarbe",
      "type": "color",
      "default": "#222222",
      "swatch": "text",
      "core": true
    },
    {
      "property": "--color-page-background",
      "group": "colors",
      "label": "Seitenhintergrund",
      "type": "color",
      "default": "#ffffff",
      "core": true
    },
    {
      "property": "--base-border-color",
      "group": "colors",
      "label": "Rahmenfarbe",
      "type": "color",
      "default": "#cccccc",
      "core": true
    },
    {
      "property": "--color-gray",
      "group": "colors",
      "label": "Textgrau",
      "type": "color",
      "default": "#555555",
      "core": false
    },
    {
      "property": "--links-color-hover",
      "group": "colors",
      "label": "Link-Hover",
      "type": "color",
      "default": "#ff5636",
      "core": false
    },
    {
      "property": "--button-background-hover",
      "group": "colors",
      "label": "Button-Hover",
      "type": "color",
      "default": "#ff5636",
      "core": false
    },

    {
      "property": "--base-font-family",
      "group": "typography",
      "label": "Grundschrift",
      "type": "font",
      "default": "system",
      "core": true
    },
    {
      "property": "--headings-font-family",
      "group": "typography",
      "label": "Überschriften",
      "type": "font",
      "default": "system",
      "core": true
    },
    {
      "property": "--base-font-size",
      "group": "typography",
      "label": "Basis-Schriftgröße",
      "type": "length",
      "unit": "rem",
      "min": 0.9375,
      "max": 1.1875,
      "step": 0.0625,
      "default": 1,
      "core": true
    },
    {
      "property": "--headings-font-weight",
      "group": "typography",
      "label": "Schriftschnitt",
      "type": "select",
      "options": [300, 400, 500, 600, 700, 800],
      "default": 700,
      "core": false
    },
    {
      "property": "--base-line-height",
      "group": "typography",
      "label": "Zeilenhöhe",
      "type": "length",
      "unit": "",
      "min": 1.3,
      "max": 1.9,
      "step": 0.05,
      "default": 1.625,
      "core": false
    },

    {
      "property": "--base-spacing-unit",
      "group": "spacing",
      "label": "Basis-Abstand",
      "type": "length",
      "unit": "rem",
      "min": 0.75,
      "max": 1.5,
      "step": 0.125,
      "default": 1,
      "core": true,
      "note": "Abgeleitete -xs/-sm/-lg/-xl rechnen via calc() automatisch mit."
    },
    {
      "property": "--grid-gutter",
      "group": "spacing",
      "label": "Spaltenabstand",
      "type": "length",
      "unit": "rem",
      "min": 0.5,
      "max": 3,
      "step": 0.25,
      "default": 1.875,
      "core": false
    },

    {
      "property": "--base-border-radius",
      "group": "shape",
      "label": "Eckenradius",
      "type": "length",
      "unit": "px",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 4,
      "core": true
    },
    {
      "property": "--base-border-width",
      "group": "shape",
      "label": "Rahmenstärke",
      "type": "length",
      "unit": "px",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "core": true
    },
    {
      "property": "--button-border-radius",
      "group": "shape",
      "label": "Button-Radius",
      "type": "length",
      "unit": "px",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 4,
      "core": false
    }
  ]
}
